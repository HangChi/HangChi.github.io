---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagList from '../../components/TagList.astro';
import { comparePostsByPriority } from '../../utils/categories';

// 分页：第一页为 /blog，后续为 /blog/2、/blog/3……
export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort(comparePostsByPriority);
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };

type PaginationItem =
  | { type: 'page'; number: number; href: string }
  | { type: 'ellipsis'; key: string };

const pageHref = (number: number) => (number === 1 ? '/blog' : `/blog/${number}`);
const visiblePages = [...new Set([
  1,
  page.currentPage - 1,
  page.currentPage,
  page.currentPage + 1,
  page.lastPage,
])]
  .filter((number) => number >= 1 && number <= page.lastPage)
  .sort((a, b) => a - b);

const paginationItems: PaginationItem[] = [];
visiblePages.forEach((number, index) => {
  const previous = visiblePages[index - 1];
  if (previous && number - previous > 1) {
    paginationItems.push({ type: 'ellipsis', key: `${previous}-${number}` });
  }
  paginationItems.push({ type: 'page', number, href: pageHref(number) });
});
---

<Layout
  title={`全部文章 · 第 ${page.currentPage}/${page.lastPage} 页`}
  description="文章归档列表"
  wide
>
  <header class="archive-head">
    <h1>全部文章</h1>
    <span>共 {page.total} 篇 · 第 {page.currentPage} / {page.lastPage} 页</span>
  </header>

  <ul class="post-list">
    {
      page.data.map((post) => (
        <li>
          <div class="post-date">
            {post.data.pinned && <span class="pin-flag">置顶</span>}
            <FormattedDate date={post.data.pubDate} compact />
          </div>
          <div class="post-body">
            <a class="post-link" href={`/blog/${post.id}/`}>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="desc">{post.data.description}</p>
            </a>
            <TagList tags={post.data.tags} />
          </div>
        </li>
      ))
    }
  </ul>

  {
    page.lastPage > 1 && (
      <nav class="pagination" aria-label="分页">
        {page.url.prev ? (
          <a class="page-btn pager" href={page.url.prev} rel="prev">
            <span aria-hidden="true">←</span> 上一页
          </a>
        ) : (
          <span class="page-btn pager disabled" aria-disabled="true"><span aria-hidden="true">←</span> 上一页</span>
        )}

        <div class="page-numbers">
          {paginationItems.map((item) =>
            item.type === 'ellipsis' ? (
              <span class="ellipsis" aria-hidden="true" data-key={item.key}>…</span>
            ) : item.number === page.currentPage ? (
              <a class="page-number active" href={item.href} aria-current="page" aria-label={`第 ${item.number} 页`}>
                {item.number}
              </a>
            ) : (
              <a class="page-number" href={item.href} aria-label={`前往第 ${item.number} 页`}>
                {item.number}
              </a>
            )
          )}
        </div>

        {page.url.next ? (
          <a class="page-btn pager" href={page.url.next} rel="next">
            下一页 <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="page-btn pager disabled" aria-disabled="true">下一页 <span aria-hidden="true">→</span></span>
        )}
      </nav>
    )
  }
</Layout>

<style>
  .archive-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    margin-bottom: 0.2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .archive-head h1 {
    margin: 0;
    font-size: 2rem;
  }
  .archive-head span {
    padding-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .post-list {
    margin: 0;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
  }
  .page-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border: 1px solid var(--border);
    justify-content: center;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .page-btn:hover {
    text-decoration: none;
    background: var(--bg-subtle);
    border-color: var(--brand);
  }
  .page-btn.disabled {
    color: var(--text-muted);
    opacity: 0.45;
    pointer-events: none;
  }
  .page-numbers {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }
  .page-number,
  .ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    min-height: 2.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .page-number {
    color: var(--text-muted);
  }
  .page-number:hover {
    border-color: var(--border-strong);
    color: var(--text);
    background: var(--bg-elevated);
    text-decoration: none;
  }
  .page-number.active {
    border-color: var(--brand);
    color: white;
    background: var(--brand-deep);
  }
  .ellipsis {
    color: var(--text-muted);
  }

  @media (max-width: 620px) {
    .archive-head h1 {
      font-size: 1.9rem;
    }
    .pagination {
      flex-wrap: wrap;
    }
    .page-numbers {
      order: -1;
      width: 100%;
    }
    .pager {
      flex: 1 1 0;
    }
  }
</style>
