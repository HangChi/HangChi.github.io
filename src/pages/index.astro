---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { comparePostsByPriority } from '../utils/categories';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort(comparePostsByPriority);
const recent = posts.slice(0, 9);
---

<Layout wide>
  <section class="hero">
    <img src="/logo.png" alt="" width="64" height="64" />
    <div>
      <h1>{SITE_TITLE}</h1>
      <p>{SITE_DESCRIPTION}</p>
    </div>
  </section>

  <section class="recent">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/blog">查看全部 <span aria-hidden="true">→</span></a>
    </div>

    {posts.length === 0 && <p class="empty">还没有文章，去写下第一篇吧。</p>}

    <ul class="post-list">
      {recent.map((post) => (
        <li>
          <div class="post-date">
            {post.data.pinned && <span class="pin-flag">置顶</span>}
            <FormattedDate date={post.data.pubDate} compact />
          </div>
          <div class="post-body">
            <a class="post-link" href={`/blog/${post.id}/`}>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="desc">{post.data.description}</p>
            </a>
            <TagList tags={post.data.tags} />
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 3.5rem 0 3rem;
  }
  .hero img {
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
    border-radius: var(--radius-md);
  }
  .hero h1 {
    margin: 0 0 0.35rem;
    font-size: 2.35rem;
    letter-spacing: -0.04em;
  }
  .hero p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.2rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .section-head h2 { margin: 0; font-size: 1.5rem; }
  .section-head a { color: var(--text-muted); font-size: var(--text-sm); white-space: nowrap; }
  .section-head a:hover { color: var(--link); text-decoration: none; }
  .empty { color: var(--text-muted); }

  @media (max-width: 600px) {
    .hero { align-items: flex-start; padding: 2.2rem 0 2rem; }
    .hero img { width: 48px; height: 48px; }
    .hero h1 { font-size: 1.75rem; }
    .hero p { font-size: 0.95rem; }
  }
</style>
