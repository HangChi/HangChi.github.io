---
// 标签徽章：渲染一组可点击标签，链接到 /tags/<tag> 聚合页。
interface Props {
  tags: string[];
  inline?: boolean;
}
const { tags, inline = false } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class={inline ? 'tags inline' : 'tags'}>
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag)}`} aria-label={`标签：${tag}`}>
            <span aria-hidden="true">#</span>{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
  }
  .tags.inline {
    margin: 0;
  }
  .tags li {
    margin: 0;
    max-width: 100%;
  }
  .tags a {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 1.7rem;
    padding: 0.14rem 0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--tag-bg);
    color: var(--tag-text);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    line-height: 1.25;
    overflow-wrap: anywhere;
    transition: background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .tags a span { margin-right: 0.12rem; color: var(--brand-cyan); }
  .tags a:hover {
    text-decoration: none;
    background: var(--surface-brand);
    color: var(--link);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 18%, transparent);
  }
</style>
