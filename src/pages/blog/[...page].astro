---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostExplorer from '../../components/PostExplorer.astro';
import { comparePostsByPriority } from '../../utils/categories';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort(comparePostsByPriority);

  return [{ params: { page: undefined }, props: { posts } }];
}

const { posts } = Astro.props as { posts: CollectionEntry<'blog'>[] };
---

<Layout title="全部文章" description="搜索并浏览全部博客文章" wide>
  <header class="archive-head">
    <h1>全部文章</h1>
  </header>

  <PostExplorer posts={posts} />
</Layout>

<style>
  .archive-head {
    position: relative;
    padding: 0 0 0.75rem 1rem;
  }
  .archive-head::before {
    position: absolute;
    inset: 0.25rem auto 0.85rem 0;
    width: 3px;
    border-radius: var(--radius-pill);
    background: var(--brand-cyan);
    content: '';
  }
  .archive-head h1 {
    margin: 0;
    font-size: 2rem;
  }
  @media (max-width: 620px) {
    .archive-head h1 { font-size: 1.9rem; }
  }
</style>
