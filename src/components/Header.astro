---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import { CATEGORY_META, CATEGORY_ORDER, getCategoryPath } from '../utils/categories';

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const isArticleActive = path.startsWith('/blog') || path.startsWith('/categories');
const articleCategories = CATEGORY_ORDER.map((slug) => CATEGORY_META[slug]);
---

<header>
  <nav aria-label="主导航">
    <a href="/" class="site-title">
      <img class="logo" src="/logo.png" alt="" width="32" height="32" />
      <span>{SITE_TITLE}</span>
    </a>

    <div class="nav-right">
      <div class="links">
        <a href="/" class={isActive('/') ? 'active' : undefined} aria-current={isActive('/') ? 'page' : undefined}>首页</a>
        <div class="nav-item">
          <a
            href="/blog"
            class={isArticleActive ? 'active' : undefined}
            aria-current={path.startsWith('/blog') ? 'page' : undefined}
            aria-haspopup="true"
          >文章</a>
          <div class="article-menu" aria-label="文章分类">
            {articleCategories.map((category) => (
              <a href={getCategoryPath(category.slug)}>
                <span>{category.name}</span>
                <small>{category.description}</small>
              </a>
            ))}
          </div>
        </div>
        <a href="/tags" class={isActive('/tags') ? 'active' : undefined} aria-current={isActive('/tags') ? 'page' : undefined}>标签</a>
        <a href="/about" class={isActive('/about') ? 'active' : undefined} aria-current={isActive('/about') ? 'page' : undefined}>关于</a>
      </div>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    min-height: 62px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(12px);
  }
  nav {
    display: flex;
    min-height: 62px;
    max-width: var(--width-wide);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
  }
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: var(--fw-bold);
    white-space: nowrap;
  }
  .site-title:hover { color: var(--link); text-decoration: none; }
  .logo { display: block; flex: 0 0 auto; border-radius: var(--radius-sm); }
  .nav-right, .links { display: flex; align-items: center; }
  .nav-right { gap: 0.8rem; }
  .links { gap: 1rem; }
  .links > a, .nav-item > a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .links > a:hover, .nav-item > a:hover { color: var(--text); text-decoration: none; }
  .links > a.active, .nav-item > a.active { border-bottom-color: var(--brand); color: var(--text); }
  .nav-item { position: relative; display: inline-flex; }
  .article-menu {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 50%;
    z-index: var(--z-overlay);
    width: 12rem;
    padding: 0.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    box-shadow: 0 12px 28px var(--shadow);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -4px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility var(--dur-fast) var(--ease-out);
  }
  .article-menu::before { position: absolute; inset: -0.55rem 0 auto; height: 0.55rem; content: ''; }
  .nav-item:hover .article-menu, .nav-item:focus-within .article-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .article-menu a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text);
  }
  .article-menu a:hover, .article-menu a:focus-visible { color: var(--link); background: var(--bg-subtle); text-decoration: none; }
  .article-menu span, .article-menu small { display: block; }
  .article-menu span { font-size: 0.88rem; line-height: 1.35; }
  .article-menu small { margin-top: 0.1rem; color: var(--text-muted); font-size: 0.72rem; line-height: 1.35; }

  @media (max-width: 600px) {
    header, nav { min-height: 104px; }
    nav { flex-direction: column; gap: 0.45rem; padding: 0.65rem 1rem; }
    .nav-right { width: 100%; justify-content: space-between; }
    .links { gap: 0.8rem; }
    .links > a, .nav-item > a { min-height: 38px; font-size: 0.84rem; }
    .article-menu { right: -2.4rem; left: auto; transform: translate(0, -4px); }
    .nav-item:hover .article-menu, .nav-item:focus-within .article-menu { transform: translate(0, 0); }
  }
</style>
