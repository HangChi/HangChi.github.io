---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 标签总览：统计每个标签的文章数，做成标签云。
const posts = (await getCollection('blog')).filter((p) => !p.data.draft);

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

// 按文章数降序排列
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title="标签" description="按标签浏览全部文章" wide>
  <header class="tag-head">
    <h1>标签</h1>
    <p class="count">共 {tags.length} 个标签</p>
  </header>

  {tags.length === 0 && <p class="empty">还没有任何标签。</p>}

  <ul class="tag-cloud">
    {
      tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag)}`}>
            <span class="hash" aria-hidden="true">#</span>{tag}
            <span class="num">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .tag-head {
    position: relative;
    padding-left: 1rem;
  }
  .tag-head::before {
    position: absolute;
    inset: 0.35rem auto 0.45rem 0;
    width: 3px;
    border-radius: var(--radius-pill);
    background: var(--brand-cyan);
    content: '';
  }
  .tag-head h1 { margin-bottom: 0.65rem; }
  .count {
    color: var(--text-muted);
    margin: 0;
  }
  .empty {
    color: var(--text-muted);
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .tag-cloud li {
    margin: 0;
    max-width: 100%;
  }
  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    max-width: 100%;
    min-height: 2.25rem;
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.35rem 0.7rem;
    border: 0;
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    font-weight: var(--fw-medium);
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .tag-cloud a:hover {
    text-decoration: none;
    background: var(--surface-brand);
    color: var(--link);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 18%, transparent);
  }
  .hash { color: var(--brand-cyan); }
  .num {
    color: var(--text-faint);
    padding-left: 0.15rem;
    font-size: 0.74rem;
    font-weight: var(--fw-medium);
    line-height: 1.25;
    min-width: 1rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    flex: 0 0 auto;
  }
</style>
