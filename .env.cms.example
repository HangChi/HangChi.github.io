# CMS API only listens on loopback. Reach it with an SSH local-forward until a domain is configured.
NODE_ENV=production
CMS_HOST=127.0.0.1
CMS_PORT=8790
CMS_DATABASE_URL=mysql://blog_cms_app:replace-with-a-long-random-password@115.159.112.148:3386/blog_cms
CMS_COOKIE_SECURE=false
CMS_SESSION_HOURS=12
EASYIMAGE_BASE_URL=http://115.159.112.148:40066
CMS_SOURCE_ROOT=/opt/blog-cms/current
CMS_RELEASES_ROOT=/var/lib/blog-cms/releases
CMS_ACTIVE_LINK=/var/lib/blog-cms/current
CMS_ADMIN_DIST=/opt/blog-cms/current/apps/admin/dist
CMS_PACKAGE_MANAGER_COMMAND=/usr/local/bin/pnpm
CMS_REMOTE_DEPLOY_HOST=39.99.232.157
CMS_REMOTE_DEPLOY_PORT=22
CMS_REMOTE_DEPLOY_USER=blogdeploy
CMS_REMOTE_DEPLOY_IDENTITY=/etc/blog-cms/deploy_key
CMS_REMOTE_KNOWN_HOSTS=/etc/blog-cms/known_hosts
CMS_REMOTE_BLOG_ROOT=/var/www/hangchi-blog

# Only used by `pnpm --filter @blog/cms create-admin`, never by the service.
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=replace-with-a-separate-long-random-password
