---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  defaultLimit?: number;
  headingLevel?: 'h2' | 'h3';
}

const { posts, defaultLimit, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const hasDefaultLimit = typeof defaultLimit === 'number';
const initialCount = hasDefaultLimit ? Math.min(defaultLimit, posts.length) : posts.length;
---

<section class="post-explorer" data-post-explorer data-default-limit={defaultLimit}>
  <div class="post-tools" data-post-controls>
    <p class="result-status" id="post-results-status" aria-live="polite">
      <span data-post-count-prefix>{hasDefaultLimit ? '显示' : '共'}</span>
      <strong data-post-count>{initialCount}</strong>
      <span data-post-count-total>{hasDefaultLimit ? ` / ${posts.length}` : ''}</span> 篇文章
    </p>
    <label class="sort-control" title="调整文章排序">
      <span class="sr-only">排序方式</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h18M6 12h12M10 18h4"></path>
      </svg>
      <select name="sort" data-post-sort>
        <option value="default">默认排序</option>
        <option value="date-desc">时间 ↓</option>
        <option value="date-asc">时间 ↑</option>
        <option value="title-asc">名称 A-Z</option>
        <option value="title-desc">名称 Z-A</option>
      </select>
    </label>
  </div>

  <ul class="post-list" data-post-list>
    {
      posts.map((post, index) => (
        <li
          data-post-item
          data-index={index}
          data-title={post.data.title}
          data-date={post.data.pubDate.valueOf()}
          data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ')}
          hidden={hasDefaultLimit && index >= defaultLimit}
        >
          <div class="post-date">
            {post.data.pinned && <span class="pin-flag">置顶</span>}
            <FormattedDate date={post.data.pubDate} compact />
          </div>
          <div class="post-body">
            <a class="post-link" href={`/blog/${post.id}/`}>
              <Heading class="post-title">{post.data.title}</Heading>
              <p class="desc">{post.data.description}</p>
            </a>
            <TagList tags={post.data.tags} />
          </div>
        </li>
      ))
    }
  </ul>

  <div class="empty-result" data-post-empty hidden>
    <Heading class="empty-title">没有找到相关文章</Heading>
    <p>换一个名称、摘要关键词或标签试试。</p>
  </div>
</section>

<script>
  const validSorts = new Set([
    'default',
    'date-desc',
    'date-asc',
    'title-asc',
    'title-desc',
  ]);
  const collator = new Intl.Collator('zh-CN', {
    numeric: true,
    sensitivity: 'base',
  });

  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('zh-CN').trim();

  document.querySelectorAll<HTMLElement>('[data-post-explorer]').forEach((explorer) => {
    const select = explorer.querySelector<HTMLSelectElement>('[data-post-sort]');
    const count = explorer.querySelector<HTMLElement>('[data-post-count]');
    const countPrefix = explorer.querySelector<HTMLElement>('[data-post-count-prefix]');
    const countTotal = explorer.querySelector<HTMLElement>('[data-post-count-total]');
    const list = explorer.querySelector<HTMLUListElement>('[data-post-list]');
    const empty = explorer.querySelector<HTMLElement>('[data-post-empty]');

    if (!select || !count || !countPrefix || !countTotal || !list || !empty) return;

    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-post-item]'));
    const limitValue = Number(explorer.dataset.defaultLimit);
    const defaultLimit = Number.isFinite(limitValue) && limitValue > 0 ? limitValue : null;
    const params = new URLSearchParams(window.location.search);
    const query = normalize(params.get('q') ?? '');
    const initialSort = params.get('sort') ?? 'default';
    select.value = validSorts.has(initialSort) ? initialSort : 'default';

    const compareItems = (a: HTMLElement, b: HTMLElement, sort: string) => {
      const titleA = a.dataset.title ?? '';
      const titleB = b.dataset.title ?? '';
      const dateA = Number(a.dataset.date ?? 0);
      const dateB = Number(b.dataset.date ?? 0);

      if (sort === 'date-desc') return dateB - dateA || collator.compare(titleA, titleB);
      if (sort === 'date-asc') return dateA - dateB || collator.compare(titleA, titleB);
      if (sort === 'title-asc') return collator.compare(titleA, titleB) || dateB - dateA;
      if (sort === 'title-desc') return collator.compare(titleB, titleA) || dateB - dateA;
      return Number(a.dataset.index ?? 0) - Number(b.dataset.index ?? 0);
    };

    const updateUrl = (sort: string) => {
      const url = new URL(window.location.href);
      if (sort === 'default') url.searchParams.delete('sort');
      else url.searchParams.set('sort', sort);
      window.history.replaceState({}, '', url);
    };

    const update = () => {
      const sort = validSorts.has(select.value) ? select.value : 'default';
      const orderedItems = [...items].sort((a, b) => compareItems(a, b, sort));
      let matchingCount = 0;
      let visibleCount = 0;

      orderedItems.forEach((item) => {
        const matches = !query || normalize(item.dataset.search ?? '').includes(query);
        if (matches) matchingCount += 1;
        const withinLimit = query || defaultLimit === null || matchingCount <= defaultLimit;
        item.hidden = !matches || !withinLimit;
        if (matches && withinLimit) visibleCount += 1;
      });
      list.append(...orderedItems);

      count.textContent = String(visibleCount);
      countPrefix.textContent = !query && defaultLimit !== null ? '显示' : '共';
      countTotal.textContent = !query && defaultLimit !== null ? ` / ${matchingCount}` : '';
      list.hidden = visibleCount === 0;
      empty.hidden = visibleCount !== 0;
      updateUrl(sort);
    };

    select.addEventListener('change', update);

    update();
  });
</script>

<style>
  .post-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.4rem 0 0.15rem;
    padding: 0.45rem 0;
  }
  .sort-control {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--text-faint);
  }
  .sort-control svg {
    position: absolute;
    left: 0.55rem;
    width: 0.85rem;
    height: 0.85rem;
    pointer-events: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  select {
    width: 7.7rem;
    height: 34px;
    min-height: 34px;
    padding: 0.2rem 0.4rem 0.2rem 1.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--text);
    background: var(--bg-subtle);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--border) 55%, transparent);
    transition: background-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  select:hover { background: var(--bg-elevated); box-shadow: inset 0 0 0 1px var(--border-strong); }
  select:focus { box-shadow: inset 0 0 0 1px var(--brand), 0 0 0 3px color-mix(in srgb, var(--brand) 14%, transparent); }
  .result-status {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }
  .result-status strong {
    color: var(--link);
    font-weight: var(--fw-bold);
  }
  .empty-result {
    padding: 3.5rem 0;
    text-align: center;
  }
  .empty-title {
    margin: 0 0 0.45rem;
    font-size: var(--text-lg);
  }
  .empty-result p {
    margin: 0;
    color: var(--text-muted);
  }
  [hidden] { display: none !important; }

  @media (max-width: 480px) {
    .post-tools { padding-block: 0.3rem; }
    select { height: 38px; min-height: 38px; }
  }
</style>
